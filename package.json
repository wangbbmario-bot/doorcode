{
  "name": "doorcode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "catalog": "python3 scripts/build_catalog.py",
    "verify:geometry": "python3 scripts/calibrate_leaves.py verify",
    "dev": "concurrently -n api,web -c magenta,cyan \"node server/index.mjs\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "vite build",
    "preview": "node server/index.mjs",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}