# =====================================================
# Caddy 配置片段 —— 门锁项目反代（配域名时用）
#
# 前提：
#   1) DNS 已把域名解析到 47.107.46.78（阿里云 DNS 加 A 记录）
#   2) doorcode 服务在 127.0.0.1:8787 或容器/宿主机可达
#   3) 走的是宿主机上的 Caddy（todo-caddy 容器），Caddyfile 在
#      /opt/todo/app/deploy/Caddyfile
#
# ⚠️ 国内合规提醒：
#   域名对外提供服务必须先完成 ICP 备案。
#   备案审核期间若要给审核员看，用 IP+端口（:8787）即可；
#   正式对外前必须切到域名 + 80/443。
# =====================================================

# ---- 门锁项目：正式域名 ----
doorcode.example.com, www.doorcode.example.com {
	encode zstd gzip

	# 生成图（server/generated 的静态目录）
	handle /generated/* {
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		root * /
		file_server
	}

	# API 与前端都在同一个 Express 进程里，直接反代过去
	reverse_proxy 127.0.0.1:8787 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
